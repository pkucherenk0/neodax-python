# Copy to .env (git-ignored) and fill in. All are OPTIONAL — defaults target UAT public endpoints.
# dotenv loads this automatically via playwright.config.ts.

# --- Endpoint overrides (default to the --project's env; set only to point at a custom target) ---
# NEODAX_BASE=https://hub.uat.yellow.pro.neodax.app          # hub: competitions / enroll
# NEODAX_AUTH_BASE=https://auth.uat.yellow.pro.neodax.app    # auth: challenge / verify
# NEODAX_TRADING_BASE=https://api.uat.yellow.pro.neodax.app  # api: trading / balances

# --- Competition run params (consumed by config/competition.ts) ---
# NEODAX_COMPETITION=pablo-15
# NEODAX_TARGET_TIER=3
# NEODAX_ORDER_NOTIONAL=100000

# --- Stage only: path to the pre-funded account pool (see configs/accounts.stage.example.json) ---
# NEODAX_STAGE_ACCOUNTS=configs/accounts.stage.json

# --- FE (browser) E2E — project `uat-browser`, see TEST_STRATEGY.md / config/e2e.ts ---
# REQUIRED to run browser E2E: the deployed UAT FE (yellow-neodax-client) origin. The default in
# config/e2e.ts is a placeholder to confirm — set this to the real UAT FE URL.
# NEODAX_FE_BASE=https://<uat-fe-host>
# NEODAX_FE_ACCESS_TOKEN_KEY=access_token     # override only if the FE's localStorage key changes
# NEODAX_FE_REFRESH_TOKEN_KEY=refresh_token

# --- HTTP resilience (rate limit + retry; see lib/http.ts) ---
# NEODAX_RPS=5             # per-worker request/sec cap. Effective rate = workers × RPS — keep modest.
# NEODAX_MAX_RETRIES=4     # retries for 429 / 5xx / network, with backoff + Retry-After
