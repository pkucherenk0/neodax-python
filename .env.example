# Copy to .env (git-ignored) and fill in. conftest.py loads it automatically (python-dotenv).
# uat is REQUIRED for the default lane; stage is only needed if you run --env=stage.

# --- uat ---
NIMBUS_UAT_BASE=https://hub.uat.example.com          # hub: competitions / enroll
NIMBUS_UAT_AUTH_BASE=https://auth.uat.example.com    # auth: challenge / verify
NIMBUS_UAT_TRADING_BASE=https://api.uat.example.com  # api: trading / balances
NIMBUS_UAT_FAUCET_URL=https://faucet.uat.example.com # funding. omit -> has_faucet=False

# --- stage (no faucet; fixed pre-funded pool instead, see NIMBUS_STAGE_ACCOUNTS below) ---
# NIMBUS_STAGE_BASE=https://hub.staging.example.com
# NIMBUS_STAGE_AUTH_BASE=https://auth.staging.example.com
# NIMBUS_STAGE_TRADING_BASE=https://api.staging.example.com

# --- Competition run params (consumed by configs/competition.py) ---
# NIMBUS_COMPETITION=legacy-15
# NIMBUS_TARGET_TIER=3
# NIMBUS_ORDER_NOTIONAL=100000

# --- Stage only: path to the pre-funded account pool (see configs/accounts.stage.example.json) ---
# NIMBUS_STAGE_ACCOUNTS=configs/accounts.stage.json

# --- UI e2e (separate Node project, e2e/) ---
# REQUIRED to run e2e/: the deployed UAT FE origin.
# NIMBUS_FE_BASE=https://<uat-fe-host>
# NIMBUS_FE_ACCESS_TOKEN_KEY=access_token     # override only if the FE's localStorage key changes
# NIMBUS_FE_REFRESH_TOKEN_KEY=refresh_token

# --- HTTP resilience (rate limit + retry; see lib/http.py) ---
# NIMBUS_RPS=5             # per-worker request/sec cap. Effective rate = workers × RPS — keep modest.
# NIMBUS_MAX_RETRIES=4     # retries for 429 / 5xx / network, with backoff + Retry-After
